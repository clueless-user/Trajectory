{
  "$schema": "../node_modules/@tauri-apps/cli/config.json",
  "productName": "Trajectory",
  "version": "0.1.0",
  "identifier": "com.trajectory.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trajectory — Personal Execution OS",
        "width": 1280,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:trajectory.db"
      ]
    }
  }
}
